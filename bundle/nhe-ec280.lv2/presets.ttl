@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix pset: <http://lv2plug.in/ns/ext/presets#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://github.com/Kiwooky/NHE-EC280#preset-a-cold-space>
    a pset:Preset ;
    lv2:appliesTo <https://github.com/Kiwooky/NHE-EC280> ;
    rdfs:label "A cold space" ;
    lv2:port
        [ lv2:symbol "volume" ; pset:value 5.0 ] ,
        [ lv2:symbol "speed" ; pset:value 0.0 ] ,
        [ lv2:symbol "duration" ; pset:value 0.898438 ] ,
        [ lv2:symbol "return_level" ; pset:value 8.091518 ] ,
        [ lv2:symbol "chorus" ; pset:value 2.092634 ] ,
        [ lv2:symbol "mode" ; pset:value 0.0 ] ,
        [ lv2:symbol "echo_taps" ; pset:value 1.0 ] ,
        [ lv2:symbol "hall_taps" ; pset:value 2.0 ] ,
        [ lv2:symbol "range" ; pset:value 0.0 ] ,
        [ lv2:symbol "tails" ; pset:value 1.0 ] .

